# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Editors
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Raw data arrays (regenerate deterministically from a seed)
*.npy
*.npz

# NOTE: examples/output/*.png are committed on purpose — they are seeded, deterministic,
# and referenced from the README. Regenerate with `python examples/*.py`.

# NEVER commit clinical data. Synthetic phantoms only.
*.dcm
*.DCM
*.ima
*.IMA
data/
phi/
RESUME.md
paper/*.bak

# built submission artefacts: regenerate with pandoc
paper/taskiq-core_jimaging.docx
paper/susy_step2_fields.txt

# Word writes these beside an open document and they are not part of the paper
~$*
~WRL*.tmp

# Proof-stage correspondence with the journal stays on this machine. MDPI marks its
# proof e-mails confidential, the proof files carry the production editors' comments,
# and the replies name them. The scripts that answered the proof are public; what they
# read and wrote is not. PROOF_REPORT.md is generated by check_proof.py and quotes those
# comments whenever it is run on a commented proof.
paper/proof/jimaging-*.docx
paper/proof/reply_to_*.txt
paper/proof/CHANGES_FOR_EDITOR.txt
paper/proof/FINAL_PROOFREAD_CHANGES.txt
paper/proof/PROOF_REPORT.md
