  "checks": [
    {
      "key": "parseval",
      "label": "integral of NPS = pixel variance",
      "kind": "identity",
      "tolerance": 1e-09,
      "why": "The NPS normalisation is an exact identity, whatever the noise model is."
    },
    {
      "key": "bridge",
      "label": "NEQ integral = prewhitening d'",
      "kind": "identity",
      "tolerance": 1e-09,
      "why": "Two algebraically identical routes to one number, sharing no code path."
    },
    {
      "key": "signal_area",
      "label": "signal area = contrast x pi r^2",
      "kind": "identity",
      "tolerance": 1e-06,
      "why": "Blurring conserves area; the signal integral cannot depend on the blur."
    },
    {
      "key": "dynamic_range",
      "label": "NPS dynamic range < 1e6 (DC excluded)",
      "kind": "identity",
      "tolerance": 0.0,
      "why": "1/NPS is meaningless where the noise power has decayed into rounding error."
    },
    {
      "key": "mtf_closed_form",
      "label": "MTF = exp(-2 pi^2 sigma^2 f^2)",
      "kind": "closed form",
      "tolerance": 5e-05,
      "why": "The edge is an analytically blurred step, so its presampled MTF is known."
    },
    {
      "key": "nps_closed_form",
      "label": "NPS = sigma^2 dx dy",
      "kind": "closed form",
      "tolerance": 0.25,
      "why": "White noise of known variance has a known flat spectrum."
    }
  ],
